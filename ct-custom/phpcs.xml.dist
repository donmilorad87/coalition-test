<?xml version="1.0"?>
<ruleset name="CT Custom">
	<description>WordPress + WordPress VIP Go coding standards for the CT Custom theme.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>

	<arg value="ps"/>
	<arg name="basepath" value="./"/>
	<arg name="parallel" value="8"/>
	<arg name="extensions" value="php"/>

	<config name="minimum_wp_version" value="6.6"/>
	<config name="testVersion" value="8.2-"/>

	<!-- WordPress Coding Standards (Core + Docs + Extra). -->
	<rule ref="WordPress"/>
	<!-- WordPress VIP rules for code running on VIP Go (performance, security, caching). -->
	<rule ref="WordPress-VIP-Go"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array" value="ct-custom"/>
		</properties>
	</rule>

	<rule ref="WordPress.Files.FileName">
		<properties>
			<property name="is_theme" value="true"/>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array" value="ct_custom,CtCustom"/>
		</properties>
	</rule>
</ruleset>
