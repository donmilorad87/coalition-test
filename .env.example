# Copy to .env and fill in real values: `cp .env.example .env`. docker compose refuses to start without them.

# Project / networking
COMPOSE_PROJECT_NAME=coalitiontest
WP_URL=http://coalitiontest.local
# Loopback IP used on this Linux host (hosts file: "<BIND_IP_LOCAL> coalitiontest.local").
BIND_IP_LOCAL=127.0.0.6
# LAN IP of this host, for other machines on the network (e.g. Windows). Use 127.0.0.6 again to disable.
BIND_IP_LAN=192.168.0.109

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
DB_NAME=wordpresstest
DB_USER=wordpresstest
DB_PASSWORD=change-me
# Database used by the theme's PHPUnit suite (wiped on every test run).
DB_TESTS_NAME=wordpresstest_tests

# WordPress admin (created on first install)
WP_ADMIN_USER=coalitiontest
WP_ADMIN_PASSWORD=change-me
WP_ADMIN_EMAIL=admin@coalitiontest.local

# Outgoing email (SMTP). Seeded into Appearance → Theme Settings → Email when that is still empty;
# edit it there afterwards. Leave MAIL_HOST empty to keep PHP's mail().
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your-mailtrap-username
MAIL_PASSWORD=your-mailtrap-password
MAIL_FROM_ADDRESS=noreply@coalitiontest.local
MAIL_FROM_NAME="Coalition Skills Test"
